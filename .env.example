# Librerías extra que necesitan los contenedores de Airflow (además del core)
_PIP_ADDITIONAL_REQUIREMENTS=apache-airflow-providers-google numpy pandas

# Ruta local a tus credenciales de gcloud (Application Default Credentials)
# Windows: %APPDATA%\gcloud  ->  ej. C:\Users\TU_USUARIO\AppData\Roaming\gcloud
# Mac/Linux: ~/.config/gcloud
GOOGLE_CREDENTIALS_PATH=